 18 + 7$\n$18 = 2 \\cdot 7 + 4$\n$7 = 1 \\cdot 4 + 3$\n$4 = 1 \\cdot 3 + 1$\n\nSo $1 = 4 - 3 = 4 - (7-4) = 2\\cdot4 - 7 = 2(18-2\\cdot7) - 7 = 2\\cdot18 - 5\\cdot7 = 2\\cdot18 - 5(25-18) = 7\\cdot18 - 5\\cdot25 = 7(93-3\\cdot25) - 5\\cdot25 = 7\\cdot93 - 26\\cdot25 = 7\\cdot93 - 26(304-3\\cdot93) = 85\\cdot93 - 26\\cdot304 = 85(397-304) - 26\\cdot304 = 85\\cdot397 - 111\\cdot304$.\n\nSo $304^{-1} \\equiv -111 \\equiv 286 \\pmod{397}$.\n\nCheck: $304 \\times 286 = 86944$. $86944 / 397$: $397 \\times 219 = 86943$. So $304 \\times 286 \\equiv 1$. ✓\n\n$c_3 = 304 + 286 + 2 = 592 \\equiv 592 - 397 = 195 \\pmod{397}$.\n\n$c_4 = c_3 + c_3^{-1} + 2$. $c_3^{-1} = 195^{-1} \\pmod{397}$.\n\n$397 = 2 \\cdot 195 + 7$\n$195 = 27 \\cdot 7 + 6$\n$7 = 1 \\cdot 6 + 1$\n\n$1 = 7 - 6 = 7 - (195 - 27\\cdot7) = 28\\cdot7 - 195 = 28(397-2\\cdot195) - 195 = 28\\cdot397 - 57\\cdot195$.\n\n$195^{-1} \\equiv -57 \\equiv 340 \\pmod{397}$.\n\n$c_4 = 195 + 340 + 2 = 537 \\equiv 537 - 397 = 140 \\pmod{397}$.\n\n$c_5 = c_4 + c_4^{-1} + 2$. $c_4^{-1} = 140^{-1} \\pmod{397}$.\n\n$397 = 2 \\cdot 140 + 117$\n$140 = 1 \\cdot 117 + 23$\n$117 = 5 \\cdot 23 + 2$\n$23 = 11 \\cdot 2 + 1$\n\n$1 = 23 - 11\\cdot2 = 23 - 11(117-5\\cdot23) = 56\\cdot23 - 11\\cdot117 = 56(140-117) - 11\\cdot117 = 56\\cdot140 - 67\\cdot117 = 56\\cdot140 - 67(397-2\\cdot140) = 190\\cdot140 - 67\\cdot397$.\n\n$140^{-1} \\equiv 190 \\pmod{397}$.\n\n$c_5 = 140 + 190 + 2 = 332$.\n\n$c_6 = c_5 + c_5^{-1} + 2$. $c_5^{-1} = 332^{-1} \\pmod{397}$.\n\n$397 = 1 \\cdot 332 + 65$\n$332 = 5 \\cdot 65 + 7$\n$65 = 9 \\cdot 7 + 2$\n$7 = 3 \\cdot 2 + 1$\n\n$1 = 7 - 3\\cdot2 = 7 - 3(65-9\\cdot7) = 28\\cdot7 - 3\\cdot65 = 28(332-5\\cdot65) - 3\\cdot65 = 28\\cdot332 - 143\\cdot65 = 28\\cdot332 - 143(397-332) = 171\\cdot332 - 143\\cdot397$.\n\n$332^{-1} \\equiv 171 \\pmod{397}$.\n\n$c_6 = 332 + 171 + 2 = 505 \\equiv 505 - 397 = 108 \\pmod{397}$.\n\n$c_7 = c_6 + c_6^{-1} + 2$. $c_6^{-1} = 108^{-1} \\pmod{397}$.\n\n$397 = 3 \\cdot 108 + 73$\n$108 = 1 \\cdot 73 + 35$\n$73 = 2 \\cdot 35 + 3$\n$35 = 11 \\cdot 3 + 2$\n$3 = 1 \\cdot 2 + 1$\n\n$1 = 3 - 2 = 3 - (35 - 11\\cdot3) = 12\\cdot3 - 35 = 12(73-2\\cdot35) - 35 = 12\\cdot73 - 25\\cdot35 = 12\\cdot73 - 25(108-73) = 37\\cdot73 - 25\\cdot108 = 37(397-3\\cdot108) - 25\\cdot108 = 37\\cdot397 - 136\\cdot108$.\n\n$108^{-1} \\equiv -136 \\equiv 261 \\pmod{397}$.\n\n$c_7 = 108 + 261 + 2 = 371$.\n\n$c_8 = c_7 + c_7^{-1} + 2$. $c_7^{-1} = 371^{-1} \\pmod{397}$.\n\n$371 \\equiv -26 \\pmod{397}$.\n$26^{-1} \\pmod{397}$: $397 = 15\\cdot26 + 7$, $26 = 3\\cdot7 + 5$, $7 = 1\\cdot5+2$, $5 = 2\\cdot2+1$.\n$1 = 5-2\\cdot2 = 5-2(7-5) = 3\\cdot5-2\\cdot7 = 3(26-3\\cdot7)-2\\cdot7 = 3\\cdot26-11\\cdot7 = 3\\cdot26-11(397-15\\cdot26) = 168\\cdot26-11\\cdot397$.\n$26^{-1} = 168$. So $371^{-1} = (-26)^{-1} = -168 = 229$.\n\n$c_8 = 371 + 229 + 2 = 602 \\equiv 602 - 397 = 205 \\pmod{397}$.\n\n$c_9 = c_8 + c_8^{-1} + 2$. $c_8^{-1} = 205^{-1} \\pmod{397}$.\n\n$397 = 1\\cdot205+192$, $205=1\\cdot192+13$, $192=14\\cdot13+10$, $13=1\\cdot10+3$, $10=3\\cdot3+1$.\n$1=10-3\\cdot3=10-3(13-10)=4\\cdot10-3\\cdot13=4(192-14\\cdot13)-3\\cdot13=4\\cdot192-59\\cdot13=4\\cdot192-59(205-192)=63\\cdot192-59\\cdot205=63(397-205)-59\\cdot205=63\\cdot397-122\\cdot205$.\n$205^{-1} \\equiv -122 \\equiv 275 \\pmod{397}$.\n\n$c_9 = 205 + 275 + 2 = 482 \\equiv 482 - 397 = 85 \\pmod{397}$.\n\n$c_{10} = c_9 + c_9^{-1} + 2$. $c_9^{-1} = 85^{-1} \\pmod{397}$.\n\n$397 = 4\\cdot85+57$, $85=1\\cdot57+28$, $57=2\\cdot28+1$.\n$1=57-2\\cdot28=57-2(85-57)=3\\cdot57-2\\cdot85=3(397-4\\cdot85)-2\\cdot85=3\\cdot397-14\\cdot85$.\n$85^{-1} \\equiv -14 \\equiv 383 \\pmod{397}$.\n\n$c_{10} = 85 + 383 + 2 = 470 \\equiv 470 - 397 = 73 \\pmod{397}$.\n\n$c_{11} = c_{10} + c_{10}^{-1} + 2$. $c_{10}^{-1} = 73^{-1} \\pmod{397}$.\n\n$397 = 5\\cdot73+32$, $73=2\\cdot32+9$, $32=3\\cdot9+5$, $9=1\\cdot5+4$, $5=1\\cdot4+1$.\n$1=5-4=5-(9-5)=2\\cdot5-9=2(32-3\\cdot9)-9=2\\cdot32-7\\cdot9=2\\cdot32-7(73-2\\cdot32)=16\\cdot32-7\\cdot73=16(397-5\\cdot73)-7\\cdot73=16\\cdot397-87\\cdot73$.\n$73^{-1} \\equiv -87 \\equiv 310 \\pmod{397}$.\n\n$c_{11} = 73 + 310 + 2 = 385$.\n\n$c_{12} = c_{11} + c_{11}^{-1} + 2$. $c_{11}^{-1} = 385^{-1} \\pmod{397}$.\n$385 \\equiv -12 \\pmod{397}$.\n$12^{-1} \\pmod{397}$: $397 = 33\\cdot12+1$. So $12^{-1} \\equiv 33 \\pmod{397}$.\n$385^{-1} = (-12)^{-1} = -33 = 364$.\n\n$c_{12} = 385 + 364 + 2 = 751 \\equiv 751 - 397 = 354 \\pmod{397}$.\n\n$c_{13} = c_{12} + c_{12}^{-1} + 2$. $c_{12}^{-1} = 354^{-1} \\pmod{397}$.\n$354 \\equiv -43 \\pmod{397}$.\n$43^{-1} \\pmod{397}$: $397 = 9\\cdot43+10$, $43=4\\cdot10+3$, $10=3\\cdot3+1$.\n$1=10-3\\cdot3=10-3(43-4\\cdot10)=13\\cdot10-3\\cdot43=13(397-9\\cdot43)-3\\cdot43=13\\cdot397-120\\cdot43$.\n$43^{-1} \\equiv -120 \\equiv 277 \\pmod{397}$.\n$354^{-1} = (-43)^{-1} = -277 = 120$.\n\n$c_{13} = 354 + 120 + 2 = 476 \\equiv 476 - 397 = 79 \\pmod{397}$.\n\n$c_{14} = c_{13} + c_{13}^{-1} + 2$. $c_{13}^{-1} = 79^{-1} \\pmod{397}$.\n$397 = 5\\cdot79+2$, $79=39\\cdot2+1$.\n$1=79-39\\cdot2=79-39(397-5\\cdot79)=200\\cdot79-39\\cdot397$.\n$79^{-1} \\equiv 200 \\pmod{397}$.\n\n$c_{14} = 79 + 200 + 2 = 281$.\n\n$c_{15} = c_{14} + c_{14}^{-1} + 2$. $c_{14}^{-1} = 281^{-1} \\pmod{397}$.\n$281 \\equiv -116 \\pmod{397}$.\n$116^{-1} \\pmod{397}$: $397 = 3\\cdot116+49$, $116=2\\cdot49+18$, $49=2\\cdot18+13$, $18=1\\cdot13+5$, $13=2\\cdot5+3$, $5=1\\cdot3+2$, $3=1\\cdot2+1$.\n$1=3-2=3-(5-3)=2\\cdot3-5=2(13-2\\cdot5)-5=2\\cdot13-5\\cdot5=2\\cdot13-5(18-13)=7\\cdot13-5\\cdot18=7(49-2\\cdot18)-5\\cdot18=7\\cdot49-19\\cdot18=7\\cdot49-19(116-2\\cdot49)=45\\cdot49-19\\cdot116=45(397-3\\cdot116)-19\\cdot116=45\\cdot397-154\\cdot116$.\n$116^{-1} \\equiv -154 \\equiv 243 \\pmod{397}$.\n$281^{-1} = (-116)^{-1} = -243 = 154$.\n\n$c_{15} = 281 + 154 + 2 = 437 \\equiv 437 - 397 = 40 \\pmod{397}$.\n\n$c_{16} = c_{15} + c_{15}^{-1} + 2$. $c_{15}^{-1} = 40^{-1} \\pmod{397}$.\n$397 = 9\\cdot40+37$, $40=1\\cdot37+3$, $37=12\\cdot3+1$.\n$1=37-12\\cdot3=37-12(40-37)=13\\cdot37-12\\cdot40=13(397-40)-12\\cdot40=13\\cdot397-25\\cdot40$.\n$40^{-1} \\equiv -25 \\equiv 372 \\pmod{397}$.\n\n$c_{16} = 40 + 372 + 2 = 414 \\equiv 414 - 397 = 17 \\pmod{397}$.\n\n$c_{17} = c_{16} + c_{16}^{-1} + 2$. $c_{16}^{-1} = 17^{-1} \\pmod{397}$.\n$397 = 23\\cdot17+6$, $17=2\\cdot6+5$, $6=1\\cdot5+1$.\n$1=6-5=6-(17-6)=2\\cdot6-17=2(397-23\\cdot17)-17=2\\cdot397-47\\cdot17$.\n$17^{-1} \\equiv -47 \\equiv 350 \\pmod{397}$.\n\n$c_{17} = 17 + 350 + 2 = 369$.\n\n$c_{18} = c_{17} + c_{17}^{-1} + 2$. $c_{17}^{-1} = 369^{-1} \\pmod{397}$.\n$369 \\equiv -28 \\pmod{397}$.\n$28^{-1} \\pmod{397}$: $397 = 14\\cdot28+5$, $28=5\\cdot5+3$, $5=1\\cdot3+2$, $3=1\\cdot2+1$.\n$1=3-2=3-(5-3)=2\\cdot3-5=2(28-5)-5=2\\cdot28-7\\cdot5=2\\cdot28-7(397-14\\cdot28)=100\\cdot28-7\\cdot397$.\n$28^{-1} = 100$. $369^{-1} = -100 = 297$.\n\n$c_{18} = 369 + 297 + 2 = 668 \\equiv 668 - 397 = 271 \\pmod{397}$.\n\n$c_{19} = c_{18} + c_{18}^{-1} + 2$. $c_{18}^{-1} = 271^{-1} \\pmod{397}$.\n$271 \\equiv -126 \\pmod{397}$.\n$126^{-1} \\pmod{397}$: $397 = 3\\cdot126+19$, $126=6\\cdot19+12$, $19=1\\cdot12+7$, $12=1\\cdot7+5$, $7=1\\cdot5+2$, $5=2\\cdot2+1$.\n$1=5-2\\cdot2=5-2(7-5)=3\\cdot5-2\\cdot7=3(12-7)-2\\cdot7=3\\cdot12-5\\cdot7=3\\cdot12-5(19-12)=8\\cdot12-5\\cdot19=8(126-6\\cdot19)-5\\cdot19=8\\cdot126-53\\cdot19=8\\cdot126-53(397-3\\cdot126)=247\\cdot126-53\\cdot397$.\n$126^{-1} \\equiv 247 \\pmod{397}$. $271^{-1} = -247 = 150$.\n\n$c_{19} = 271 + 150 + 2 = 423 \\equiv 423 - 397 = 26 \\pmod{397}$.\n\n$c_{20} = c_{19} + c_{19}^{-1} + 2$. $c_{19}^{-1} = 26^{-1} \\pmod{397} = 168$ (computed earlier).\n\n$c_{20} = 26 + 168 + 2 = 196$.\n\nInteresting! $c_{20} = 196$. Let me check: $196 = 14^2$.\n\n$c_{21} = c_{20} + c_{20}^{-1} + 2$. $c_{20}^{-1} = 196^{-1} \\pmod{397}$.\n$196 = 14^2$. $14^{-1} \\pmod{397}$: $397 = 28\\cdot14+5$, $14=2\\cdot5+4$, $5=1\\cdot4+1$.\n$1=5-4=5-(14-5)=2\\cdot5-14=2(397-28\\cdot14)-14=2\\cdot397-57\\cdot14$.\n$14^{-1} \\equiv -57 \\equiv 340 \\pmod{397}$.\n$196^{-1} = 14^{-2} = 340^2 = 115600$. $115600 / 397$: $397 \\times 291 = 115527$. $115600 - 115527 = 73$.\nSo $196^{-1} = 73$.\n\nCheck: $196 \\times 73 = 14308$. $14308 / 397$: $397 \\times 36 = 14292$. $14308 - 14292 = 16$. Hmm, that's not 1.\n\nLet me recompute. $14^{-1} \\equiv -57 \\equiv 340$. Check: $14 \\times 340 = 4760$. $4760 / 397 = 12$, $12 \\times 397 = 4764$. So $14 \\times 340 \\equiv -4$. That's not right.\n\nLet me redo. $397 = 28 \\times 14 + 5$. $28 \\times 14 = 392$. $397 - 392 = 5$. ✓\n$14 = 2 \\times 5 + 4$. ✓\n$5 = 1 \\times 4 + 1$. ✓\n\n$1 = 5 - 4 = 5 - (14 - 2 \\times 5) = 3 \\times 5 - 14 = 3 \\times (397 - 28 \\times 14) - 14 = 3 \\times 397 - 85 \\times 14$.\n\nSo $14^{-1} \\equiv -85 \\equiv 312 \\pmod{397}$.\n\nCheck: $14 \\times 312 = 4368$. $4368 / 397 = 11$, $11 \\times 397 = 4367$. $4368 - 4367 = 1$. ✓\n\n$196^{-1} = 14^{-2} = 312^2 = 97344$. $97344 / 397$: $397 \\times 245 = 97265$. $97344 - 97265 = 79$.\nSo $196^{-1} = 79$.\n\nCheck: $196 \\times 79 = 15484$. $15484 / 397$: $397 \\times 39 = 15483$. $15484 - 15483 = 1$. ✓\n\n$c_{21} = 196 + 79 + 2 = 277$.\n\n$c_{22} = c_{21} + c_{21}^{-1} + 2$. $c_{21}^{-1} = 277^{-1} \\pmod{397}$.\nEarlier I computed $43^{-1} \\equiv -120 \\equiv 277$. So $277 = 43^{-1}$, meaning $277^{-1} = 43$.\n\n$c_{22} = 277 + 43 + 2 = 322$.\n\n$c_{23} = c_{22} + c_{22}^{-1} + 2$. $c_{22}^{-1} = 322^{-1} \\pmod{397}$.\n$322 \\equiv -75 \\pmod{397}$.\n$75^{-1} \\pmod{397}$: $397 = 5\\cdot75+22$, $75=3\\cdot22+9$, $22=2\\cdot9+4$, $9=2\\cdot4+1$.\n$1=9-2\\cdot4=9-2(22-9)=3\\cdot9-2\\cdot22=3(75-3\\cdot22)-2\\cdot22=3\\cdot75-11\\cdot22=3\\cdot75-11(397-5\\cdot75)=58\\cdot75-11\\cdot397$.\n$75^{-1} = 58$. $322^{-1} = -58 = 339$.\n\n$c_{23} = 322 + 339 + 2 = 663 \\equiv 663 - 397 = 266 \\pmod{397}$.\n\n$c_{24} = c_{23} + c_{23}^{-1} + 2$. $c_{23}^{-1} = 266^{-1} \\pmod{397}$.\n$266 \\equiv -131 \\pmod{397}$.\n$131^{-1} \\pmod{397}$: $397 = 3\\cdot131+4$, $131=32\\cdot4+3$, $4=1\\cdot3+1$.\n$1=4-3=4-(131-32\\cdot4)=33\\cdot4-131=33(397-3\\cdot131)-131=33\\cdot397-100\\cdot131$.\n$131^{-1} \\equiv -100 \\equiv 297 \\pmod{397}$.\n$266^{-1} = -297 = 100$.\n\n$c_{24} = 266 + 100 + 2 = 368$.\n\n$c_{25} = c_{24} + c_{24}^{-1} + 2$. $c_{24}^{-1} = 368^{-1} \\pmod{397}$.\n$368 \\equiv -29 \\pmod{397}$.\n$29^{-1} \\pmod{397}$: $397 = 13\\cdot29+20$, $29=1\\cdot20+9$, $20=2\\cdot9+2$, $9=4\\cdot2+1$.\n$1=9-4\\cdot2=9-4(20-9)=5\\cdot9-4\\cdot20=5(29-20)-4\\cdot20=5\\cdot29-9\\cdot20=5\\cdot29-9(397-13\\cdot29)=122\\cdot29-9\\cdot397$.\n$29^{-1} = 122$. $368^{-1} = -122 = 275$.\n\n$c_{25} = 368 + 275 + 2 = 645 \\equiv 645 - 397 = 248 \\pmod{397}$.\n\nThis is getting tedious. Let me think about the structure more carefully.\n\nThe recurrence is $c_{n+1} = c_n + c_n^{-1} + 2$ in $\\mathbb{F}_{397}$.\n\nSince we're in a finite field, the sequence must eventually be periodic. The values $c_n$ are in $\\mathbb{F}_{397}$ (and $c_n \\neq 0$ since $a_n \\neq 0$... wait, can $a_n = 0$? If $a_n = 0$, then $a_{n+1}(a_n+1)^2 = a_n$ becomes $a_{n+1} = 0$, so once $a_n = 0$, all subsequent terms are 0. But $a_0 = 1 \\neq 0$, so we need to check if $a_n$ can ever be 0.\n\nIf $a_n = 0$, then $c_n$ would be undefined (division by zero). But $c_n = 1/a_n$, and if $a_n = 0$, the recurrence $a_{n+1}(a_n+1)^2 = a_n$ gives $a_{n+1} = 0$. So $a_n = 0$ is a fixed point.\n\nCan we reach $a_n = 0$ from $a_0 = 1$? $a_{n+1} = a_n/(a_n+1)^2$. If $a_n \\neq 0$ and $a_n \\neq -1$, then $a_{n+1} \\neq 0$. So starting from $a_0 = 1$, we never reach $a_n = 0$ or $a_n = -1$ (i.e., 396). So all $c_n$ are well-defined.\n\nThe sequence $c_n$ takes values in $\\mathbb{F}_{397}^*$, which has 396 elements. Since the recurrence $c_{n+1} = f(c_n)$ is deterministic, the sequence is eventually periodic. Since we start from $c_0 = 1$ and the map $f(x) = x + x^{-1} + 2$ is a function on $\\mathbb{F}_{397}^*$, the sequence is purely periodic (from the start) if and only if $f$ maps $\\mathbb{F}_{397}^*$ to itself and the orbit of 1 is periodic from the s