+class _TextTokenCounter:
+    """Small tokenizer.json wrapper used only when telemetry is requested."""
+
+    def __init__(self, model_or_file: str) -> None:
+        path = Path(model_or_file).expanduser()
+        tokenizer_file = path if path.is_file() else path / "tokenizer.json"
+        if not tokenizer_file.is_file():
+            raise ValueError(f"tokenizer.json not found: {tokenizer_file}")
+        try:
+            from tokenizers import Tokenizer
+        except ImportError as exc:
+            raise ValueError(
+                "--tokenizer requires the telemetry extra: pip install 'benchlocal-cli[telemetry]'"
+            ) from exc
+        self.path = str(tokenizer_file.resolve())
+        self._tokenizer = Tokenizer.from_file(self.path)
+
+    def count(self, value: object) -> int:
+        if value is None:
+            return 0
+        if isinstance(value, str):
+            text = value
+        else:
+            text = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+        if not text:
+            return 0
+        return len(self._tokenizer.encode(text, add_special_tokens=False).ids)
+
+
+def _response_token_metrics(
+    raw_response: dict,
+    token_counter: _TextTokenCounter | None,
+    latency_seconds: float | None = None,
+) -> dict:
+    """Extract reported usage and independently reconstruct output categories."""
+    usage = raw_response.get("usage") if isinstance(raw_response, dict) else None
+    usage = usage if isinstance(usage, dict) else {}
+    choices = raw_response.get("choices") if isinstance(raw_response, dict) else None
+    choice = choices[0] if isinstance(choices, list) and choices and isinstance(choices[0], dict) else {}
+    message = choice.get("message") if isinstance(choice.get("message"), dict) else {}
+    details = usage.get("completion_tokens_details")
+    details = details if isinstance(details, dict) else {}
+
+    reported_reasoning = details.get("reasoning_tokens")
+    if not isinstance(reported_reasoning, int):
+        reported_reasoning = usage.get("reasoning_tokens")
+    if not isinstance(reported_reasoning, int):
+        reported_reasoning = None
+
+    reconstructed_reasoning = None
+    reconstructed_answer = None
+    reconstructed_tool_calls = None
+    if token_counter is not None:
+        reasoning_value = message.get("reasoning_content")
+        if reasoning_value is None:
+            reasoning_value = message.get("reasoning")
+        reconstructed_reasoning = token_counter.count(reasoning_value)
+        reconstructed_answer = token_counter.count(message.get("content"))
+        reconstructed_tool_calls = token_counter.count(message.get("tool_calls"))
+
+    completion = usage.get("completion_tokens")
+    latency = float(latency_seconds) if latency_seconds is not None else None
+    return {
+        "reported_prompt_tokens": usage.get("prompt_tokens") if isinstance(usage.get("prompt_tokens"), int) else None,
+        "reported_completion_tokens": completion if isinstance(completion, int) else None,
+        "reported_total_tokens": usage.get("total_tokens") if isinstance(usage.get("total_tokens"), int) else None,
+        "reported_reasoning_tokens": reported_reasoning,
+        "reconstructed_reasoning_tokens": reconstructed_reasoning,
+        "reconstructed_answer_tokens": reconstructed_answer,
+        "reconstructed_tool_call_tokens": reconstructed_tool_calls,
+        "finish_reason": choice.get("finish_reason"),
+        "latency_seconds": latency,
+        "reported_completion_tps": (
+            float(completion) / latency
+            if isinstance(completion, int) and latency is not None and latency > 0
+            else None
+        ),
+    }
+
+
+def _scenario_token_metrics(
+    raw_response: dict | None,
+    token_counter: _TextTokenCounter | None,
+    response_latencies_seconds: list[float] | None = None,
+) -> dict | None:
+    if not isinstance(raw_response, dict):
+        return None
+    nested = raw_response.get("responses")
+    responses = [item for item in nested if isinstance(item, dict)] if isinstance(nested, list) else [raw_response]
+    if not responses:
+        return {
+            "tokenizer": token_counter.path if token_counter is not None else None,
+            "response_count": 0,
+            "telemetry_complete": False,
+            "per_response": [],
+        }
+    latencies = response_latencies_seconds or []
+    per_response = [
+        _response_token_metrics(
+            response,
+            token_counter,
+            latencies[index] if index < len(latencies) else None,
+        )
+        for index, response in enumerate(responses)
+    ]
+
+    def summed(key: str) -> int | None:
+        values = [row.get(key) for row in per_response]
+        integers = [value for value in values if isinstance(value, int)]
+        return sum(integers) if integers else None
+
+    reported_reasoning = summed("reported_reasoning_tokens")
+    reconstructed_reasoning = summed("reconstructed_reasoning_tokens")
+    reasoning_tokens = reported_reasoning if reported_reasoning is not None else reconstructed_reasoning
+    reasoning_source = (
+        "reported" if reported_reasoning is not None
+        else "reconstructed" if reconstructed_reasoning is not None
+        else "unavailable"
+    )
+    completion = summed("reported_completion_tokens")
+    total_latency = sum(latencies) if latencies else None
+    return {
+        "tokenizer": token_counter.path if token_counter is not None else None,
+        "response_count": len(responses),
+        "telemetry_complete": len(responses) == len(latencies),
+        "reported_prompt_tokens": summed("reported_prompt_tokens"),
+        "reported_completion_tokens": completion,
+        "reported_total_tokens": summed("reported_total_tokens"),
+        "reported_reasoning_tokens": reported_reasoning,
+        "reconstructed_reasoning_tokens": reconstructed_reasoning,
+        "reconstructed_answer_tokens": summed("reconstructed_answer_tokens"),
+        "reconstructed_tool_call_tokens": summed("reconstructed_tool_call_tokens"),
+        "reasoning_tokens": reasoning_tokens,
+        "reasoning_token_source": reasoning_source,
+        "reasoning_share_of_completion": (
+            float(reasoning_tokens) / completion
+            if isinstance(reasoning_tokens, int) and isinstance(completion, int) and completion > 0
+            else None
+        ),
+        "reported_completion_tps": (
