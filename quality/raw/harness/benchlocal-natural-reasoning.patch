diff --git a/tests/test_token_metrics.py b/tests/test_token_metrics.py
new file mode 100644
index 0000000..f478896
--- /dev/null
+++ b/tests/test_token_metrics.py
@@ -0,0 +1,92 @@
+from benchlocal_cli.runner import Runner, _scenario_token_metrics
+
+
+class _FakeCounter:
+    path = "/models/qwen/tokenizer.json"
+
+    @staticmethod
+    def count(value):
+        if value is None:
+            return 0
+        if isinstance(value, str):
+            return len(value.split())
+        return 3
+
+
+def _response(reasoning, content, prompt, completion, total, finish="stop"):
+    return {
+        "choices": [{
+            "finish_reason": finish,
+            "message": {
+                "reasoning_content": reasoning,
+                "content": content,
+            },
+        }],
+        "usage": {
+            "prompt_tokens": prompt,
+            "completion_tokens": completion,
+            "total_tokens": total,
+        },
+    }
+
+
+def test_token_metrics_reconstruct_reasoning_separately_from_answer():
+    metrics = _scenario_token_metrics(
+        _response("one two three", "four five", 10, 7, 17),
+        _FakeCounter(),
+        [2.0],
+    )
+
+    assert metrics["reported_prompt_tokens"] == 10
+    assert metrics["reported_completion_tokens"] == 7
+    assert metrics["reconstructed_reasoning_tokens"] == 3
+    assert metrics["reconstructed_answer_tokens"] == 2
+    assert metrics["reasoning_tokens"] == 3
+    assert metrics["reasoning_token_source"] == "reconstructed"
+    assert metrics["reported_completion_tps"] == 3.5
+    assert metrics["telemetry_complete"] is True
+
+
+def test_token_metrics_aggregate_multiturn_and_prefer_reported_reasoning():
+    first = _response("one two", "three", 10, 4, 14)
+    first["usage"]["completion_tokens_details"] = {"reasoning_tokens": 2}
+    second = _response("one two three", "four", 20, 5, 25, "tool_calls")
+    second["usage"]["completion_tokens_details"] = {"reasoning_tokens": 3}
+
+    metrics = _scenario_token_metrics(
+        {"multi_turn": True, "responses": [first, second]},
+        _FakeCounter(),
+        [1.0, 2.0],
+    )
+
+    assert metrics["response_count"] == 2
+    assert metrics["reported_prompt_tokens"] == 30
+    assert metrics["reported_completion_tokens"] == 9
+    assert metrics["reported_reasoning_tokens"] == 5
+    assert metrics["reconstructed_reasoning_tokens"] == 5
+    assert metrics["reasoning_tokens"] == 5
+    assert metrics["reasoning_token_source"] == "reported"
+    assert metrics["finish_reasons"] == ["stop", "tool_calls"]
+    assert metrics["reported_completion_tps"] == 3.0
+
+
+def test_token_metrics_marks_out_of_process_agent_telemetry_incomplete():
+    metrics = _scenario_token_metrics(
+        {"multi_turn": True, "responses": []},
+        _FakeCounter(),
+        [],
+    )
+
+    assert metrics["response_count"] == 0
+    assert metrics["telemetry_complete"] is False
+
+
+def test_scenario_session_endpoint_is_opt_in_and_url_safe(monkeypatch):
+    runner = Runner(endpoint="http://127.0.0.1:19000/v1", model="fake")
+    scenario = {"pack_id": "hermesagent-20", "id": "HA-01"}
+    assert runner._scenario_session_endpoint(scenario, 1) == "http://127.0.0.1:19000/v1"
+
+    monkeypatch.setenv("BENCHLOCAL_TELEMETRY_SESSION_PATHS", "1")
+    assert runner._scenario_session_endpoint(scenario, 1) == (
+        "http://127.0.0.1:19000/session/hermesagent-20%2FHA-01%2Fr1/v1"
+    )
